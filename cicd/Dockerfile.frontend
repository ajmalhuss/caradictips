# Frontend image for Substrait: build the Vite app, then serve the static bundle
# with nginx on port 80. Built from the REPO ROOT, so COPY paths are repo-relative.
#
# Only the FINAL stage ships, so only its OS packages are scanned for
# vulnerabilities — the node build stage is discarded and never scanned.
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ .
# Same-origin API: the ingress routes /api to the backend, so the app calls the
# backend via relative /api paths — no absolute URL is baked into the bundle.
ENV VITE_API_URL=""
RUN npm run build

# `stable-alpine` is a FLOATING tag: it tracks nginx's stable branch on the newest
# Alpine release, and Docker Hub rebuilds it whenever either moves. A pinned minor
# freezes you on the Alpine branch it was cut against and accumulates fixable CVEs.
FROM nginx:stable-alpine
# Apply Alpine's outstanding security updates on every build (Trivy: a finding with
# a fixed version blocks promotion to production). Cache key is the base digest, so
# this re-runs exactly when the base moves.
RUN apk upgrade --no-cache
COPY --from=build /app/dist /usr/share/nginx/html
COPY cicd/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80